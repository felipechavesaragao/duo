{
  "name": "duo",
  "version": "0.1.0",
  "description": "Claude Code e Codex na mesma janela do terminal",
  "type": "module",
  "bin": {
    "duo": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.check.json",
